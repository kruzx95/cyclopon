# ==============================================================================
# CycloPon .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Credentials (Secrets)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example

# Private Keys, Certificates & SSH
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
*.pub

# ------------------------------------------------------------------------------
# 2. Database, Storage & Backup Data
# ------------------------------------------------------------------------------
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
*.sql

# Backups & Archives (dibuat oleh scripts/backup.sh)
backups/
*.tar.gz
*.tgz
*.zip
*.bak
*.backup

# GPX Route Uploads
public/gpx/

# ------------------------------------------------------------------------------
# 3. Dependencies & Build Artifacts
# ------------------------------------------------------------------------------
node_modules/

# ------------------------------------------------------------------------------
# 4. Logs & Process Artifacts
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Docker Local Bind & Volume Mounts
# ------------------------------------------------------------------------------
caddy_data/
caddy_config/
traccar_data/
traccar_logs/

# ------------------------------------------------------------------------------
# 6. Testing, Diagnostics & Temporary Files
# ------------------------------------------------------------------------------
reports/test-report-*.md
# Contoh berkas Excel hasil ekspor (dibuat ulang oleh scripts/ala-ultra-export-sample.js)
reports/*.xlsx
coverage/
.nyc_output/
.superpowers/
tmp/
temp/
*.tmp

# ------------------------------------------------------------------------------
# 7. OS & IDE Specific Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Local Deployment Cheatsheet / Personal Notes
DEPLOY_COMMANDS.md

# Local OpenCode skills (copied from Claude-BugHunter)
.opencode/

# OpenCode config (contains API key reference)
opencode.json

# Graphify tool outputs
graphify-out/
