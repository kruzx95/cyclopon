PORT=3000
NODE_ENV=production

# Admin Credentials (Wajib diganti dengan kredensial kuat untuk VPS)
ADMIN_USER=admin
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_sangat_kuat

# Session & Token Encryption Secret (Generate random string min 32 karakter)
SESSION_SECRET=change_this_to_random_32char_string

# Traccar GPS Engine Integration
TRACCAR_HOST=http://localhost:8082
TRACCAR_USER=admin@cyclopon.local
TRACCAR_PASS=changeme

# Virtual COT (garis potong bergerak)
# Kill-switch global: set false untuk mematikan evaluasi DNF otomatis di semua event
VIRTUAL_COT_ENABLED=true
# Umur maksimum posisi rider agar dianggap segar (menit)
VIRTUAL_COT_FRESH_MIN=10
# Toleransi jarak di belakang marker sebelum DNF (km)
VIRTUAL_COT_MARGIN_KM=1.0
# Jika tidak ada telemetri baru selama N menit, evaluasi event dibekukan
VIRTUAL_COT_GAP_MIN=15
# TTL cache evaluasi (detik)
VIRTUAL_COT_EVAL_TTL_SEC=20
